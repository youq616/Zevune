/bin/
/out/
*.exe
*.test
coverage.out
.env
.env.*
!.env.example
*.key
*.pem
wallet*
secrets/
node-data/
.DS_Store
*.journal
# Explicit source exceptions; wallet data remains excluded.
!/integration/orchard/src/wallet.rs
!/integration/orchard/src/wallet_history.rs
!/integration/orchard/src/wallet_flow_tests.rs
!/integration/orchard/src/wallet/
/integration/orchard/src/wallet/*
!/integration/orchard/src/wallet/vault.rs
*.vault
*.zwallet
!/integration/orchard/src/wallet/vault/
/integration/orchard/src/wallet/vault/*
!/integration/orchard/src/wallet/vault/store.rs
!/integration/orchard/src/wallet/vault/store/
/integration/orchard/src/wallet/vault/store/*
!/integration/orchard/src/wallet/vault/store/tests.rs

# Node signing material and local signed outbox exports must never be committed.
**/priv_validator_key.json
**/priv_validator_state.json
**/node_key.json
*.tx

# Exact source exceptions for wallet journal compaction.
!/integration/orchard/src/wallet/vault/store/compact.rs
!/integration/orchard/src/wallet/vault/store/compact_tests.rs
__pycache__/

# Exact code exceptions; wallet data and arbitrary wallet-named files stay ignored.
!/scripts/wallet_backup.py
!/scripts/wallet_backup_backend.py
!/.github/workflows/wallet-backup-catalog.yml

# Portable encrypted packages are data, not source.
*.zvbackup
!/scripts/wallet_archive.py
!/.github/workflows/wallet-backup-archive.yml

# Offline payment requests contain plaintext intent, never source.
*.zvrequest
