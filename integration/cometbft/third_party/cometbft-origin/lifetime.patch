+// stoppingPeer preserves the real peer's bounded Send behavior while refusing
+// new sends after reactor shutdown, including indirect PeerState.PickSendVote
+// and AddPeer's initial send. An in-flight Send is joined, never abandoned.
+type stoppingPeer struct {
+	p2p.Peer
+	done <-chan struct{}
+}
+
+func (p *stoppingPeer) IsRunning() bool {
+	select {
+	case <-p.done:
+		return false
+	default:
+		return p.Peer.IsRunning()
+	}
+}
+
+func (p *stoppingPeer) Send(e p2p.Envelope) bool {
+	return p.IsRunning() && p.Peer.Send(e)
+}
+
+func (p *stoppingPeer) TrySend(e p2p.Envelope) bool {
+	return p.IsRunning() && p.Peer.TrySend(e)
+}
