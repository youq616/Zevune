  "checks": [
    {
      "id": "version_and_origin",
      "result": "PASS_DESIGN",
      "assessment": "Private OnceLock initializer uses only compile-time crate::CIRCUIT; no external key, input-selected version, fallback or changed dependency. Future version requires re-reviewed version/storage binding."
    },
    {
      "id": "send_sync",
      "result": "PASS_DESIGN",
      "assessment": "Observed upstream API page identifies 0.15.5 and VerifyingKey Send+Sync; OnceLock Sync requires T Send+Sync. Locked native builds still required; no unsafe or custom trait implementations allowed."
    },
    {
      "id": "lifetime",
      "result": "PASS_DESIGN",
      "assessment": "Only immutable public key retained for static process lifetime; verifier caches stay owned and individually dropped. Last verifier drop does not reclaim static key, and process exit does not invoke static Drop."
    },
    {
      "id": "failure",
      "result": "PASS_DESIGN",
      "assessment": "Initializer panic propagates and cell remains uninitialized; later calls may retry same fixed build. No partially initialized key or accepting fallback. Not permanent poison or once-only counting failed attempts."
    },
    {
      "id": "reentrancy",
      "result": "PASS_DESIGN",
      "assessment": "Initializer must not call same getter or AuthorizationVerifier::new; official contract makes reentrancy erroneous and current implementation may deadlock. Direct fixed upstream build has no project callback."
    },
    {
      "id": "cache_isolation",
      "result": "PASS_DESIGN",
      "assessment": "Each new/default verifier obtains shared immutable key and its own VerifiedCache::default(). Exact bytes/digest, decode first, real signature/binding/proof validation, success-only insertion and per-instance poisoned-cache error unchanged."
    },
    {
      "id": "callers_and_replay",
      "result": "PASS_DESIGN",
      "assessment": "PoolStore creation and replay, active export/verify/copy, worker sessions, WalletProver and vault outbox still receive independent new verifier/cache. Triple source/target/final-source genuine replay and all state checks unchanged."
    },
    {
      "id": "meaningful_regression",
      "result": "PASS_DESIGN",
      "assessment": "One genuine payment fixture, real warm A and private contains true; concurrent new instances share exact fixed key/version but contain false, then each actually verifies and contains true. Canonically decoded signature/proof mutants require exact Authorization and remain uncached; no direct remember or fake verifier."
    },
    {
      "id": "concurrency_claim",
      "result": "PASS_DESIGN",
      "assessment": "Proposed concurrent construction/use may run after warm initialization. Design explicitly declines cold-first-init contention claim without a fresh-process test; std synchronization guarantee is separate from measured test coverage."
    },
    {
      "id": "unchanged_acceptance",
      "result": "PASS_DESIGN",
      "assessment": "No test/fixture/assertion/caller reduction, no workflow/concurrency/time-budget/dependency changes. New source/tree needs new independent code review and full Ubuntu/Windows native gates."
    }
  ],
