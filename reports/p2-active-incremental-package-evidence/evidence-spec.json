    "native_log_summary.py": "Earlier-stage method reference in native-expectation.md; no claim that this previous helper or previous candidate execution is reproduced by the current evidence archive."
  },
  "intentional_exclusions": [
    {
      "paths": "carriers/**",
      "reason": "Root capture transport wrappers duplicate the exact decoded raw files. Selectively retained code-review wrappers are separately named fixed files and actually cited by original reviewer reports."
    },
    {
      "paths": "payloads/c2-operator-linux.zip, payloads/c2-operator-windows.zip, payloads/c3-operator-linux.zip, payloads/c3-operator-windows.zip",
      "reason": "Complete operator ZIPs and executable payloads are intentionally absent from the repository archive. Their artifact API digests, exact manifest members, author download observations and independent full-payload verification reports are retained. No downloaded binary is executed by this collector."
    },
    {
      "paths": "C1-upload.json, C2-upload.json, C3-upload.json, later upload manifests",
      "reason": "Author GitHub upload carriers duplicate full source text and are outside the evidence scope; immutable Git source IDs and exact Git tree identities are retained."
    },
    {
      "paths": "root-progress.json, runtime-pr-template.md, doc-preparation.md, storage-review-pre-scope.json",
      "reason": "Mutable progress or preparatory drafts are not frozen final review originals."
    },
    {
      "paths": "c2-nonrust-observations-partial.json, c3-nonrust-observations-partial.json",
      "reason": "Unreferenced intermediate diagnostic or partial observations are superseded by complete independently authored frozen formal results; original formal rejection records are retained unchanged."
    },
    {
      "paths": "__pycache__/**, temporary files, arbitrary newly discovered files",
      "reason": "Not evidence. The fixed specification must be deliberately amended before freezing to add a necessary new original."
    },
    {
      "paths": "existing repository source, tests, workflows and older reports",
      "reason": "Already bound to immutable Git candidates; they are not duplicated or rewritten in this stage evidence directory."
    },
    {
      "paths": "review lock/freeze control files",
      "reason": "Control files remain in scratch. Their identities, every admitted source file identity, root report-read declaration, runtime identity, reference closure and omissions are embedded in the generated archive manifest; the collector does not grant independent review credit."
    }
  ],
  "native_manifests": [
    "c1-native-original-manifest.json",
    "c2-native-original-manifest.json",
    "c3-native-original-manifest.json"
  ],
  "scope": "Only the explicit fixed files below and exact entries admitted by the three frozen native manifests may be archived. Unknown files are never automatically included."
}
